# .npmrc — applies to Railway's Nixpacks build and to CI.
#
# npm 10.9.1's arborist crashes while resolving the peer set around
# @vitejs/devtools-*:
#   npm error Cannot read properties of null (reading 'edgesOut')
# It is not transient — a cache clean and a plain retry both reproduced it.
# Without this flag the Railway build fails during install, before it ever
# reaches nuxt build.
legacy-peer-deps=true

# Build logs are long enough already; drop the funding/audit noise so real
# errors are findable.
fund=false
audit=false
